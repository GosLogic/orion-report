{
    // Pdf output directory
    "markdown-pdf.outputDirectory": "",
    // paper size and margins
    "markdown-pdf.format": "A4",
    "markdown-pdf.margin": {
      "top": "1cm",
      "right": "1cm",
      "bottom": "1cm",
      "left": "1cm"
    },
  
    "markdown-pdf.renderDelay": 2000,
    // styles
    "markdown-pdf.styles": [
      "styles.css"
    ]
  }
  